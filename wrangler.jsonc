// File map: Cloudflare Worker, AI binding, static assets, and rate limit.

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ritmo-claro-demo",
  "main": "worker.js",
  "compatibility_date": "2026-10-09",
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "AI_PROVIDER": "workers-ai",
    "OPEN_WEIGHT_MODEL": "@cf/qwen/qwen3.8-27b",
    "GEMINI_MODEL": "gemini-3.5-flash",
    "GOOGLE_CLIENT_ID": "605518414596-9hfolosoqalvvjo36mcvc5l9sd4g6ro9.apps.googleusercontent.com",
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "7462810",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "AI_IP_RATE_LIMITER",
      "namespace_id": "7462811",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
}
